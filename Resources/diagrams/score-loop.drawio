<mxfile host="CPractice"><diagram name="三场得分求和"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="开始：sum=0，i=0" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="220" y="30" width="200" height="60" as="geometry"/></mxCell><mxCell id="test" value="i &lt; 3？" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="160" height="100" as="geometry"/></mxCell><mxCell id="step" value="sum += score[i]&#10;i += 1" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="200" height="70" as="geometry"/></mxCell><mxCell id="end" value="输出 sum，结束" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="310" width="200" height="70" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="start" target="test" style="endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="是" edge="1" parent="1" source="test" target="step" style="endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="否" edge="1" parent="1" source="test" target="end" style="endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="下一轮" edge="1" parent="1" source="step" target="test" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=0;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="345"/><mxPoint x="20" y="190"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
